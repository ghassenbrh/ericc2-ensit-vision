<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="ericc2_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.38 0.40 0.44 1.0</ambient>
      <background>0.11 0.13 0.16 1.0</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="studio_key_light">
      <cast_shadows>true</cast_shadows>
      <pose>2 -2 4 0 0 0</pose>
      <diffuse>1.0 0.98 0.95 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <direction>-0.45 0.45 -0.77</direction>
    </light>

    <light type="directional" name="studio_fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>-2 2 3 0 0 0</pose>
      <diffuse>0.45 0.55 0.70 1</diffuse>
      <specular>0.2 0.25 0.3 1</specular>
      <direction>0.5 -0.5 -0.7</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.14 0.16 0.19 1</ambient>
            <diffuse>0.18 0.20 0.24 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inspection Workbench (top surface at z = 0.30 m) -->
    <model name="industrial_workbench">
      <static>true</static>
      <pose>0.45 0.0 0.15 0 0 0</pose>
      <link name="top">
        <collision name="collision">
          <geometry><box><size>0.50 0.90 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.90 0.30</size></box></geometry>
          <material>
            <ambient>0.20 0.22 0.25 1</ambient>
            <diffuse>0.26 0.28 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red Cube (Left) -->
    <model name="red_cube">
      <static>true</static>
      <pose>0.46 -0.22 0.345 0 0 0.2</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.09 0.09 0.09</size></box></geometry>
          <material>
            <ambient>0.85 0.08 0.08 1</ambient>
            <diffuse>0.95 0.10 0.10 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Green Cube (Center) -->
    <model name="green_cube">
      <static>true</static>
      <pose>0.46 0.0 0.345 0 0 -0.15</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.09 0.09 0.09</size></box></geometry>
          <material>
            <ambient>0.08 0.75 0.18 1</ambient>
            <diffuse>0.10 0.90 0.22 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Blue Cube (Right) -->
    <model name="blue_cube">
      <static>true</static>
      <pose>0.46 0.22 0.345 0 0 0.35</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.09 0.09 0.09</size></box></geometry>
          <material>
            <ambient>0.08 0.25 0.85 1</ambient>
            <diffuse>0.10 0.35 0.95 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
